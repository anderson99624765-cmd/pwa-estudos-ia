rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validCategory(data) {
      return data.keys().hasOnly(['name', 'level', 'createdAt', 'updatedAt'])
        && data.name is string
        && data.name.size() > 0 && data.name.size() <= 60
        && data.level in ['iniciante', 'intermediario', 'avancado'];
    }

    match /users/{userId} {
      match /categories/{catId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validCategory(request.resource.data);
      }

      // Escritos SOMENTE pela Cloud Function (Admin SDK ignora as regras).
      // O cliente só lê. Assim o usuário não consegue zerar o próprio limite diário.
      match /ai_sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
      match /usage/{day} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }
  }
}
